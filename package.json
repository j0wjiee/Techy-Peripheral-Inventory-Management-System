{
  "name": "techy-inventory",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-dev-ports.js",
    "dev": "concurrently --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=./backend --watch-path=./.env backend/index.js",
    "dev:web": "vite frontend --host 127.0.0.1",
    "build": "vite build frontend",
    "start": "node backend/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "argon2": "0.41.1",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "multer": "2.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.4.1",
    "concurrently": "9.1.2",
    "prisma": "5.22.0",
    "vite": "5.4.15"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma"
  }
}
